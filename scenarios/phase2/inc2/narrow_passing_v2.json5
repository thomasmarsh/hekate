// TAS-129: the Increment 2 same-facility narrow passing fixture.
//
// One shared continuous-width bikeway carries both narrow modes, and each mode
// declares the `pass` tactic with the same authored lateral policy, so the
// kernel's own eligibility tactic decides the maneuver: the faster bicycle
// catches the slower scooter and displaces to the facility's passing side.
// Nothing scripts a speed or a position.
//
// The two demand rates are authored sparse on purpose: over the 1900-tick
// horizon the suite runs, the scooter source admits one leader and the bicycle
// source one follower, so the run carries exactly one overtaking interval — the
// contract's "one observation per participant pair". Each rate is the smallest
// that admits its one arrival at the benchmark seed, which the suite pins; the
// faster bicycle is admitted 17.5 s behind the slower scooter, which is what
// gives it a leader to catch inside the run.
//
// Every body, speed, and profile entry is constant (`min == max`), so the
// sampled profile is the authored value: the suite compares the realized
// capsule dimensions, the free speed, and the maneuver envelope against the
// template with no sampling slack. The two clearance bands are declared in
// strictly increasing thresholds, the narrow mode gate names the participating
// modes, and the close band sits below the clearance the authored geometry
// actually yields (the pass is measured at 0.78 m), so the pass records the
// study band's duration without a violation. Each participant reaches the end
// of the 350 m guide path inside the suite's horizon, which is the fixture's
// route-completion evidence.
//
// This is `CC-OVERTAKE` evidence: `docs/benchmark-matrix.md` §7.3 names
// `scenarios/phase2/inc2/narrow_passing_v2.json5` as the narrow-narrow
// overtaking fixture (§7.4 item 6).
{
  schema_version: 2,
  id: 'narrow_passing_v2',
  coordinate_system: { x: 'east_m', y: 'north_m' },
  paths: [
    { id: 'bikeway_guide', points: [ { x: 0.0, y: 0.0 }, { x: 350.0, y: 0.0 } ] },
  ],
  portals: [
    { id: 'entry', path: 'bikeway_guide', end: 'start', width_m: 6.0 },
    { id: 'exit', path: 'bikeway_guide', end: 'end', width_m: 6.0 },
  ],
  boundaries: [
    { id: 'world', points: [
      { x: -20.0, y: -20.0 }, { x: 370.0, y: -20.0 },
      { x: 370.0, y: 20.0 }, { x: -20.0, y: 20.0 },
    ] },
  ],
  regions: [
    { id: 'bikeway_band', points: [
      { x: 0.0, y: -3.0 }, { x: 350.0, y: -3.0 },
      { x: 350.0, y: 3.0 }, { x: 0.0, y: 3.0 },
    ] },
  ],
  facilities: [
    { id: 'bikeway', region: 'bikeway_band', reference_path: 'bikeway_guide',
      width_m: 6.0, nominal_direction: 'forward',
      access: { modes: [ 'bicycle', 'scooter' ] }, lateral_use: 'shared',
      lateral_policy: { passing_side: 'left' },
      speed_policy: { limit_mps: null } },
  ],
  movements: [
    { id: 'through', from: 'entry', to: 'exit', path: 'bikeway_guide',
      priority: 0, direction: 'forward' },
  ],
  permissions: [],
  clearance_bands: [
    { id: 'narrow_close', threshold_m: 0.5, violation: true,
      applies_to_modes: [ 'bicycle', 'scooter' ] },
    { id: 'narrow_study', threshold_m: 2.0, violation: false },
  ],
  maneuver_policy: {
    commit: { min_predicted_clearance_m: 0.25, hold_timeout_s: 2.0 },
  },
  mode_templates: [
    {
      id: 'bicycle',
      body: { kind: 'capsule', length_m: { min: 1.8, max: 1.8 },
        radius_m: { min: 0.35, max: 0.35 } },
      motion: 'single_body_wheeled',
      tactics: [ 'follow', 'stop', 'yield', 'overtake', 'pass' ],
      access: { facility_kinds: [ 'facility' ], nominal_direction: 'either',
        speed_policy: { limit_mps: null } },
      occupancy: 'operator_only',
      profiles: {
        speed_mps: { min: 9.0, max: 9.0 },
        max_accel_mps2: { min: 1.2, max: 1.2 },
        comfortable_brake_mps2: { min: 2.0, max: 2.0 },
        time_gap_s: { min: 1.0, max: 1.0 },
        steering_rate_max_rad_s: { min: 0.9, max: 0.9 },
        lateral_accel_max_mps2: { min: 2.0, max: 2.0 },
        lateral_clearance_m: { min: 0.3, max: 0.3 },
        compliance: { min: 1.0, max: 1.0 },
      },
      lateral: { target_clearance_m: 0.75, horizon_s: 2.0 },
    },
    {
      id: 'scooter',
      body: { kind: 'capsule', length_m: { min: 1.2, max: 1.2 },
        radius_m: { min: 0.28, max: 0.28 } },
      motion: 'single_body_wheeled',
      tactics: [ 'follow', 'stop', 'yield', 'overtake', 'pass' ],
      access: { facility_kinds: [ 'facility' ], nominal_direction: 'either',
        speed_policy: { limit_mps: null } },
      occupancy: 'operator_only',
      profiles: {
        speed_mps: { min: 4.5, max: 4.5 },
        max_accel_mps2: { min: 1.2, max: 1.2 },
        comfortable_brake_mps2: { min: 2.0, max: 2.0 },
        time_gap_s: { min: 1.0, max: 1.0 },
        steering_rate_max_rad_s: { min: 0.9, max: 0.9 },
        lateral_accel_max_mps2: { min: 2.0, max: 2.0 },
        lateral_clearance_m: { min: 0.3, max: 0.3 },
        compliance: { min: 1.0, max: 1.0 },
      },
      lateral: { target_clearance_m: 0.75, horizon_s: 2.0 },
    },
  ],
  demand: [
    { id: 'bicycle_inflow', mode: 'bicycle',
      spawn: { rate: {
        portal: 'entry',
        rate_per_hour: 100.0,
        interval_s: { start_s: 0.0, end_s: null },
        choice: { movements: [ { movement: 'through', weight: 1.0 } ] },
      } } },
    { id: 'scooter_inflow', mode: 'scooter',
      spawn: { rate: {
        portal: 'entry',
        rate_per_hour: 20.0,
        interval_s: { start_s: 0.0, end_s: null },
        choice: { movements: [ { movement: 'through', weight: 1.0 } ] },
      } } },
  ],
}
