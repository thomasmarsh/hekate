// TAS-078: the Increment 1 narrow signal fixture.
//
// One straight bikeway per narrow mode, each carrying an authored stop line and
// a fixed-time signal head that holds red before turning green, so every narrow
// agent yields to the head, holds the line, and then rides on to complete the
// facility route: the Increment 1 "isolated signal" rung the benchmark matrix
// names (`narrow_signal_v2`). One mode per facility and no leader, so the run is
// isolated.
//
// Both templates author constant (min == max) bodies and desired speeds, so the
// sampled profile is the authored value (`T-DIM`) and the fixture test holds
// every sample to the profile's command envelope and to the authored free speed
// (`T-ENV`, `T-SPD`) once the head is green.
{
  schema_version: 2,
  id: 'narrow_signal_v2',
  coordinate_system: { x: 'east_m', y: 'north_m' },
  paths: [
    { id: 'bicycle_path', points: [ { x: -20.0, y: 0.0 }, { x: 200.0, y: 0.0 } ] },
    { id: 'scooter_path', points: [ { x: -20.0, y: -6.0 }, { x: 200.0, y: -6.0 } ] },
  ],
  portals: [
    { id: 'bicycle_entry', path: 'bicycle_path', end: 'start', width_m: 3.0 },
    { id: 'bicycle_exit', path: 'bicycle_path', end: 'end', width_m: 3.0 },
    { id: 'scooter_entry', path: 'scooter_path', end: 'start', width_m: 3.0 },
    { id: 'scooter_exit', path: 'scooter_path', end: 'end', width_m: 3.0 },
  ],
  boundaries: [
    { id: 'world', points: [
      { x: -40.0, y: -20.0 }, { x: 220.0, y: -20.0 },
      { x: 220.0, y: 20.0 }, { x: -40.0, y: 20.0 },
    ] },
  ],
  regions: [
    { id: 'bicycle_band', points: [
      { x: -20.0, y: -1.5 }, { x: 200.0, y: -1.5 },
      { x: 200.0, y: 1.5 }, { x: -20.0, y: 1.5 },
    ] },
    { id: 'scooter_band', points: [
      { x: -20.0, y: -7.5 }, { x: 200.0, y: -7.5 },
      { x: 200.0, y: -4.5 }, { x: -20.0, y: -4.5 },
    ] },
  ],
  facilities: [
    { id: 'bicycle_lane', region: 'bicycle_band', reference_path: 'bicycle_path',
      width_m: 3.0, nominal_direction: 'forward',
      access: { modes: [ 'bicycle' ] }, lateral_use: 'shared',
      speed_policy: { limit_mps: null } },
    { id: 'scooter_lane', region: 'scooter_band', reference_path: 'scooter_path',
      width_m: 3.0, nominal_direction: 'forward',
      access: { modes: [ 'scooter' ] }, lateral_use: 'shared',
      speed_policy: { limit_mps: null } },
  ],
  movements: [
    { id: 'bicycle_through', from: 'bicycle_entry', to: 'bicycle_exit',
      path: 'bicycle_path', priority: 0, stop_line_m: 60.0, direction: 'forward' },
    { id: 'scooter_through', from: 'scooter_entry', to: 'scooter_exit',
      path: 'scooter_path', priority: 0, stop_line_m: 60.0, direction: 'forward' },
  ],
  rules: [
    { id: 'bicycle_head_rule', movement: 'bicycle_through', kind: 'signal',
      signal: 'bicycle_signal' },
    { id: 'scooter_head_rule', movement: 'scooter_through', kind: 'signal',
      signal: 'scooter_signal' },
  ],
  signals: [
    { id: 'bicycle_signal',
      heads: [ { id: 'bicycle_head', movement: 'bicycle_through' } ],
      phases: [
        { duration_s: 30.0, states: [ { head: 'bicycle_head', color: 'red' } ] },
        { duration_s: 120.0, states: [ { head: 'bicycle_head', color: 'green' } ] },
      ] },
    { id: 'scooter_signal',
      heads: [ { id: 'scooter_head', movement: 'scooter_through' } ],
      phases: [
        { duration_s: 30.0, states: [ { head: 'scooter_head', color: 'red' } ] },
        { duration_s: 120.0, states: [ { head: 'scooter_head', color: 'green' } ] },
      ] },
  ],
  mode_templates: [
    {
      id: 'bicycle',
      body: { kind: 'capsule', length_m: { min: 1.8, max: 1.8 },
        radius_m: { min: 0.35, max: 0.35 } },
      motion: 'single_body_wheeled',
      tactics: [ 'follow', 'stop', 'yield' ],
      access: { facility_kinds: [ 'facility' ], nominal_direction: 'either',
        speed_policy: { limit_mps: null } },
      occupancy: 'operator_only',
      profiles: {
        speed_mps: { min: 5.0, max: 5.0 },
        max_accel_mps2: { min: 1.2, max: 1.2 },
        comfortable_brake_mps2: { min: 2.0, max: 2.0 },
        time_gap_s: { min: 1.0, max: 1.0 },
        steering_rate_max_rad_s: { min: 0.9, max: 0.9 },
        lateral_clearance_m: { min: 0.3, max: 0.3 },
        compliance: { min: 1.0, max: 1.0 },
      },
    },
    {
      id: 'scooter',
      body: { kind: 'capsule', length_m: { min: 1.1, max: 1.1 },
        radius_m: { min: 0.3, max: 0.3 } },
      motion: 'single_body_wheeled',
      tactics: [ 'follow', 'stop', 'yield' ],
      access: { facility_kinds: [ 'facility' ], nominal_direction: 'either',
        speed_policy: { limit_mps: null } },
      occupancy: 'operator_only',
      profiles: {
        speed_mps: { min: 6.0, max: 6.0 },
        max_accel_mps2: { min: 1.5, max: 1.5 },
        comfortable_brake_mps2: { min: 2.5, max: 2.5 },
        time_gap_s: { min: 1.0, max: 1.0 },
        steering_rate_max_rad_s: { min: 1.0, max: 1.0 },
        lateral_clearance_m: { min: 0.3, max: 0.3 },
        compliance: { min: 1.0, max: 1.0 },
      },
    },
  ],
  permissions: [],
  demand: [
    { id: 'bicycle_inflow', mode: 'bicycle',
      spawn: { rate: {
        portal: 'bicycle_entry',
        rate_per_hour: 60.0,
        interval_s: { start_s: 0.0, end_s: null },
        choice: { movements: [ { movement: 'bicycle_through', weight: 1.0 } ] },
      } } },
    { id: 'scooter_inflow', mode: 'scooter',
      spawn: { rate: {
        portal: 'scooter_entry',
        rate_per_hour: 60.0,
        interval_s: { start_s: 0.0, end_s: null },
        choice: { movements: [ { movement: 'scooter_through', weight: 1.0 } ] },
      } } },
  ],
}
