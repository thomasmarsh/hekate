  "tolerances": {
    "T-SEP": {
      "quantity": "per-mode-pair minimum surface separation, m",
      "bound": ">= -1e-9",
      "baseline": "phase1-or-fixture-reference"
    },
    "T-REG": {
      "quantity": "collision-event count on the fixture, records",
      "bound": "<= frozen Phase 1 count for the same fixture",
      "baseline": "phase1"
    },
    "T-CONS": {
      "quantity": "agent/passenger/route conservation residual",
      "bound": "= 0",
      "baseline": "phase1-or-increment-4-or-7"
    },
    "T-DEAD": {
      "quantity": "unresolved mutual-yield steps",
      "bound": "= 0",
      "baseline": "increment-5"
    },
    "T-O1": {
      "quantity": "abs(predicted - executed minimum clearance), m",
      "bound": "<= 0.10",
      "baseline": "increment-2"
    },
    "T-O2": {
      "quantity": "close-pass minimum body-to-body clearance, m",
      "bound": ">= authored clearance band - 0.01",
      "baseline": "increment-2"
    },
    "T-O3": {
      "quantity": "boundary-crossings without an emitted event, count",
      "bound": "= 0",
      "baseline": "increment-2"
    },
    "T-H1": {
      "quantity": "minimum separation in the opposing corridor, m",
      "bound": ">= -1e-9",
      "baseline": "increment-2"
    },
    "T-H2": {
      "quantity": "occupied-opposing-corridor bypasses, count",
      "bound": "= 0",
      "baseline": "increment-2"
    },
    "T-DWELL": {
      "quantity": "abs(realized dwell - hand-computed dwell formula), s",
      "bound": "<= 1e-9",
      "baseline": "increment-4"
    },
    "T-OCC": {
      "quantity": "bus occupancy, passengers",
      "bound": "0 <= occupancy <= capacity",
      "baseline": "increment-4"
    },
    "T-TTC": {
      "quantity": "TTC/PET reporting resolution, s; applicability status presence",
      "bound": "resolution <= 1e-6; status present out of range",
      "baseline": "def-005"
    },
    "T-CLASS": {
      "quantity": "forced-classification count, records",
      "bound": "= 0",
      "baseline": "increment-6"
    },
    "T-GROUP": {
      "quantity": "stranded group members, count",
      "bound": "= 0",
      "baseline": "increment-5"
    },
    "T-STABLE": {
      "quantity": "material-conclusion verdict flips between standard and fine",
      "bound": "= 0 flips, or each flip reported sensitive",
      "baseline": "increment-7"
    },
    "T-RT": {
      "quantity": "path-world-path coordinate round-trip error, m",
      "bound": "<= 1e-9",
      "baseline": "increment-1"
    },
    "T-DIM": {
      "quantity": "realized body dimension vs authored template, m",
      "bound": "<= 1e-12",
      "baseline": "authored-version-2-template"
    },
    "T-ENV": {
      "quantity": "command-envelope violations, count",
      "bound": "= 0",
      "baseline": "increment-1-or-3"
    },
    "T-SPD": {
      "quantity": "steady-state free-speed error vs authored constant desired speed, m/s",
      "bound": "<= 1e-6 after declared settling distance",
      "baseline": "increment-1-or-3"
    },
    "T-ART": {
      "quantity": "max segment pose error vs high-resolution reference, m",
      "bound": "<= 0.05",
      "baseline": "increment-3"
    },
    "T-OFF": {
      "quantity": "off-tracking error vs reference, m",
      "bound": "<= 0.05",
      "baseline": "increment-3"
    },
    "T-SWEPT": {
      "quantity": "missed segment contacts vs all-pairs reference, count",
      "bound": "= 0",
      "baseline": "increment-3"
    }
  },
