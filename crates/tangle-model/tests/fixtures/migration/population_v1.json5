// Golden migration fixture: the Phase 1 walking skeleton as a version-1
// document — one guide path, no demand, and a constant-speed population.
// `population_v2.json` is its normalized version-2 form. The authored profiles
// match the population's body and speed, so migrating the walking skeleton
// preserves the compiled scenario exactly.
{
  schema_version: 1,
  id: 'migration_population_v1',
  coordinate_system: { x: 'east_m', y: 'north_m' },
  paths: [
    {
      id: 'guide',
      points: [
        { x: 0.0, y: 0.0 },
        { x: 60.0, y: 0.0 },
        { x: 120.0, y: 0.0 },
      ],
    },
  ],
  portals: [
    { id: 'west_entry', path: 'guide', end: 'start', width_m: 3.5 },
    { id: 'east_exit', path: 'guide', end: 'end', width_m: 3.5 },
  ],
  population: {
    vehicle_count: 6,
    vehicle_speed_mps: 12.0,
    vehicle_spacing_m: 20.0,
    vehicle_length_m: 4.5,
    vehicle_width_m: 1.8,
  },
  profiles: {
    speed_mps: { min: 12.0, max: 12.0 },
    length_m: { min: 4.5, max: 4.5 },
    width_m: { min: 1.8, max: 1.8 },
    time_gap_s: { min: 1.0, max: 2.0 },
    max_accel_mps2: { min: 1.2, max: 2.5 },
    comfortable_brake_mps2: { min: 2.0, max: 3.5 },
    compliance: { min: 1.0, max: 1.0 },
  },
}
